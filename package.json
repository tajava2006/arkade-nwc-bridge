{
  "name": "arkade-nwc-bridge",
  "module": "src/index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "start": "bun run src/index.ts",
    "dev": "bun --hot run src/index.ts",
    "show-nsec": "bun run scripts/show-nsec.ts",
    "show-btc-key": "bun run scripts/show-btc-key.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test test/unit test/nostr test/integration",
    "test:live": "RUN_LIVE_TESTS=1 bun test test/live",
    "upgrade": "bun update @arkade-os/sdk @arkade-os/boltz-swap nostr-tools light-bolt11-decoder qr eventsource --latest && bun run typecheck && bun run test"
  },
  "devDependencies": {
    "@types/bun": "latest"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@arkade-os/boltz-swap": "^0.3.48",
    "@arkade-os/sdk": "^0.4.43",
    "@noble/curves": "2.0.1",
    "@scure/base": "^2.0.0",
    "@scure/btc-signer": "2.0.1",
    "eventsource": "^4.1.0",
    "light-bolt11-decoder": "^3.2.0",
    "nostr-tools": "^2.23.9",
    "qr": "^0.6.0"
  }
}
