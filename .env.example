# Arkade identity. Paste the nsec from your Arkade Wallet's backup screen,
# or generate a fresh one. See DESIGN.md §3 for why we use nsec instead of a
# mnemonic.
ARK_NSEC=""

# Network this bridge talks to. Affects which ASP / Boltz endpoint is used.
# One of: bitcoin | signet | mutinynet | regtest
NETWORK="bitcoin"

# Ark service provider. Default targets the Ark Labs mainnet ASP.
ARK_SERVER_URL="https://arkade.computer"

# Comma-separated list of Nostr relays the wallet service will listen on
# and publish responses to. Pick relays that don't drop ephemeral events.
NWC_RELAYS="wss://relay.getalby.com/v1,wss://relay.damus.io"

# Local-only HTTP UI. Do not bind to 0.0.0.0 — there is no auth.
HTTP_BIND="127.0.0.1"
HTTP_PORT=4282

# SQLite file. Created on first boot if missing.
DB_PATH="./data/bridge.sqlite"
